# ── SECRETS — never commit these ──────────────────────────────────
# Deny every .env variant, then allow the template back. The previous list named
# specific suffixes, so .env.bak / .env.push / .env.dbpush slipped through and
# were committed with live credentials in them.
.env*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ── DEPENDENCIES ──────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── NEXT.JS BUILD ─────────────────────────────────────────────────
.next/
out/
build/

# ── NESTJS BUILD ──────────────────────────────────────────────────
dist/

# ── TURBO ─────────────────────────────────────────────────────────
.turbo/

# ── VERCEL ────────────────────────────────────────────────────────
.vercel/

# ── TESTING ───────────────────────────────────────────────────────
coverage/
.nyc_output/
jest-results.json

# ── MISC ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json
.idea/

# ── DEBUG ─────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── TYPESCRIPT ────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── SUPABASE ──────────────────────────────────────────────────────
supabase/.temp/

# Local design mockups / screenshots
*.jpeg
WhatsApp Image*
