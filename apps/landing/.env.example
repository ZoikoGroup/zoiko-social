# Base URL of the main web app (apps/web). The landing site's navigation, search
# and calls to action link into it, and because they are separate deployments the
# links have to be absolute.
#
# Optional. Unset, it falls back per environment: https://app.zoikosocial.com for
# a production build, http://localhost:3000 otherwise. Set it to override — for a
# staging app, or a web dev server on a non-default port.
#
# It must be present at BUILD time, not run time: Next inlines NEXT_PUBLIC_* into
# the bundle, so setting it only in the process environment of an already-built
# app has no effect.
NEXT_PUBLIC_APP_URL=http://localhost:3000
