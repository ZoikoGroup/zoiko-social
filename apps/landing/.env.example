# Base URL of the main web app (apps/web). The landing site's navigation and
# calls to action link into it, and because they are separate deployments the
# links have to be absolute.
#
# Set this in the Vercel project settings for the landing site. Without it the
# links fall back to http://localhost:3000, which is correct for local
# development but broken in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
