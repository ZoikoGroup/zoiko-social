{
  "name": "zoiko-social",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @zoiko/api dev",
    "dev:web": "pnpm --filter @zoiko/web dev",
    "dev:landing": "pnpm --filter @zoiko/landing dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "clean": "turbo run clean && rm -rf node_modules",
    "check:migrations": "node scripts/check-migrations.mjs"
  },
  "devDependencies": {
    "@turbo/windows-64": "2.10.1",
    "@types/node": "^26.0.1",
    "next": "^16.2.11",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23 <9",
      "picomatch": ">=4.0.4",
      "glob": ">=10.5.0",
      "fast-uri": ">=3.1.5 <4",
      "tmp": ">=0.2.6",
      "socket.io-parser": ">=4.2.7 <5",
      "find-my-way": ">=9.7.0 <10",
      "sharp": ">=0.35.0 <1",
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@5": ">=5.0.9 <6",
      "js-yaml@3": ">=3.15.1 <4",
      "js-yaml@4": ">=4.3.1 <5",
      "nanoid@3": ">=3.3.17 <4"
    }
  }
}
